# Copy to .env and fill in your key(s). The .env file is gitignored.
#
# The coach collects EVERY env var whose name starts with GEMINI_API_KEY
# (see server/resources/gemini.py and server/main.py) and rotates between them
# on quota / rate-limit (429) errors. Provide one, or several for rotation.

# Single key (minimum to enable coaching):
GEMINI_API_KEY=your-gemini-api-key-here

# Optional additional keys for rotation — add as many as you like:
# GEMINI_API_KEY_1=your-second-gemini-api-key
# GEMINI_API_KEY_2=your-third-gemini-api-key
