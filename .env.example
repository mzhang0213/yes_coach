# Copy to .env and fill in. Only the backend you pick needs its settings.

# ── Coach backend ────────────────────────────────────────────
# "gemini" (default) or "lmstudio"
COACH_BACKEND=gemini

# ── Gemini ───────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
# Any var starting with GEMINI_API_KEY is used; keys rotate on rate-limit/quota errors.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# ...or several in one var:
# GEMINI_API_KEYS=key1,key2

# ── LM Studio (OpenAI-compatible server, e.g. Gemma on your own box) ──
# Base URL as reachable from this machine (with or without /v1).
LMSTUDIO_URL=https://lm.example.com
# Model id as LM Studio lists it; leave empty to use whatever model is loaded.
LMSTUDIO_MODEL=google/gemma-3-12b
# Optional bearer token, e.g. if your proxy requires auth.
LMSTUDIO_API_KEY=

# ── Screenshots for vision calls (off unless 1) ──────────────
COACH_SCREENSHOTS=0

# League client lockfile (champ select / game phase). Only needed for a non-default install:
# defaults are /Applications/League of Legends.app/Contents/LoL/lockfile (macOS) and
# C:\Riot Games\League of Legends\lockfile (Windows).
# LEAGUE_LOCKFILE=

# ── Player level (auto-detected from the client: solo/flex rank + champion mastery) ──
# Override the level of play the coach pitches advice at: new | iron … challenger (e.g. gold).
# COACH_RANK=
# Override champion experience, e.g. "first time on this champion" or "one-trick".
# COACH_EXPERIENCE=
